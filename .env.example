# Copy this file to .env and fill in your real values. Never share this file or commit it anywhere public.

# From DigitalOcean → Databases → your cluster → Connection Details → "Connection string"
DATABASE_URL=postgresql://user:password@host:25060/dbname?sslmode=require

# A long random secret used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string
